# /etc/chan-gateway/domain.env
#
# Shared domain config for the gateway. Loaded by the identity,
# devserver-control, and devserver-proxy systemd units
# (EnvironmentFile=-...), so the public hostnames live in ONE place
# instead of being repeated per service.
# Generated by packaging/gateway/scripts/configure.sh; this file in the repo is the
# reference template.
#
# All public origins are explicit; replace these example.com origins with yours.
# DNS records and certificates cover gw.example.com, proxy.example.com and
# *.p1.proxy.example.com. The identity edge routes to port 7000. The tunnel
# ingress routes /v1/tunnel to port 7100 as h2c (nginx grpc_pass), and / to
# port 7002 for health/readiness. The tenant wildcard routes to port 7002.
# Restart all services after editing:
#   systemctl restart chan-gateway-identity chan-gateway-devserver-control chan-gateway-devserver-proxy

BASE_URL=https://gw.example.com
DEVSERVER_PROXY_ORIGIN=https://proxy.example.com
DEVSERVER_TUNNEL_ORIGIN=https://proxy.example.com
DEVSERVER_PROXY_BASE_URL=https://p1.proxy.example.com
DASHBOARD_URL=https://gw.example.com/workspaces
