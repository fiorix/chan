# chan-e2e-nginx: the devserver-tunnel e2e's nginx TLS edge.
#
# Adds nginx to the runtime rootfs so one more container in the same zone can
# wear the production shape of the tunnel ingress: TLS + h2 on
# `proxy.{domain}`, `grpc_pass` of `/v1/tunnel` as h2c into devserver-proxy's
# tunnel listener (gateway/docs/dev-setup.md, "The TLS edges"). The base
# already carries curl, openssl, python3 and iproute2, and the edge needs no
# binary of ours, so nginx is the only addition.
#
# Build: sudo sdme fs build -f chan-e2e-nginx nginx-edge.sdme
FROM chan-e2e-run-v2
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nginx && \
    rm -rf /var/lib/apt/lists/*
