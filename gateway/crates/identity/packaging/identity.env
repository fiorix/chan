# /etc/chan-gateway/identity.env
#
# Edit this file then `systemctl restart chan-gateway-identity`.
# Permissions are 0640 root:chan-gateway-identity; do not relax.

BIND_ADDR=127.0.0.1:7000
# Proxy-authenticated token validation is never served by the public listener.
INTERNAL_BIND_ADDR=127.0.0.1:7004
# BASE_URL, DEVSERVER_PROXY_ORIGIN, and DEVSERVER_TUNNEL_ORIGIN are
# required in the shared /etc/chan-gateway/domain.env.

# Non-DDL application role. Database-owner credentials belong only in
# /etc/chan-gateway/migrate.env.
DATABASE_URL=postgres://chan_gateway_identity:REPLACE@127.0.0.1/chan_gateway
CHAN_GATEWAY_MIGRATIONS=external
EXPECTED_SQLX_MIGRATION=18
DATABASE_ROLE_POLICY_VERSION=2

# True in production behind TLS-terminating reverse proxy.
COOKIE_SECURE=true

PROFILE_SERVICE_URL=http://127.0.0.1:7001
PROFILE_AUTH_TOKEN=
# Profile operator bearer used only for durable policy/composite admin calls.
PROFILE_ADMIN_TOKEN=
# Set true for deny-by-default policy resolution.
DEVSERVER_POLICY_REQUIRED=false

# Bearer devserver-proxy presents on /internal/v1/tokens/validate.
# Required and distinct from PROFILE_AUTH_TOKEN; must equal
# devserver-proxy's IDENTITY_INTERNAL_TOKEN. openssl rand -hex 32
IDENTITY_INTERNAL_TOKEN=

# Bearer accepted only by POST /internal/v1/sessions/whoami. Leave empty to
# disable that route. It must not equal any other identity bearer.
IDENTITY_SESSION_INTERNAL_TOKEN=

# Bearer for GET /internal/v1/wireguard/peers; empty disables the route.
# Every node's peer agent presents this one value. Give it only to peer
# agents and keep it distinct from all other bearers.
WIREGUARD_AGENT_TOKEN=

# WireGuard enrollment is off while the three values below are unset. Set
# them together, after the kernel interface of every listed node is up, and
# set WIREGUARD_POOL_V4 in profile.env with them.
#
# WIREGUARD_INGRESSES lists every proxy node that terminates WireGuard as
# id=public_key@endpoint, with ';' between nodes:
#   p1=<key>@p1.proxy.example.com:51820;p2=<key>@p2.proxy.example.com:51820
# The id is the node's DEVSERVER_PROXY_ID and its agent's
# WIREGUARD_AGENT_HOST_ID. The key is what `wg show <interface> public-key`
# prints on that node. The endpoint is the host:port desktops reach its
# interface on, an IPv6 address in brackets. A desktop that reads only one
# ingress uses the first entry. The value needs no quotes in this file:
# systemd reads it to the end of the line.
# WIREGUARD_INGRESSES=p1=<interface-public-key>@p1.proxy.example.com:51820
#
# The tunnel address every listed interface answers on: one IPv4 address,
# one IPv6 address, or one of each. Keep it out of profile's allocation: see
# the pool comment in profile.env.
# WIREGUARD_INGRESS_ADDRESSES=10.7.0.1,fd00:7::1
# The networks a desktop routes into its tunnels; each address above must be
# inside one of them.
# WIREGUARD_ALLOWED_IPS=10.7.0.1/32,fd00:7::1/128
# Seconds between a desktop's keepalives: 25 when unset, 0 for none.
# WIREGUARD_PERSISTENT_KEEPALIVE=25

# Ed25519 admission signing key as canonical unpadded base64url of the raw
# 32-byte secret key. Only identity holds this key; devserver-control holds
# the corresponding DEVSERVER_ADMISSION_VERIFYING_KEYS ring.
DEVSERVER_ADMISSION_SIGNING_KEY=
# The matching one-or-two-key ring is also required locally to verify
# browser-bound admission artifacts; it is not secret.
DEVSERVER_ADMISSION_VERIFYING_KEYS=

# Private Ed25519 seed for short-lived browser entry artifacts. Proxies receive
# only the corresponding public DEVSERVER_ENTRY_VERIFYING_KEYS ring.
DEVSERVER_ENTRY_SIGNING_KEY=

# Operator bearer for identity's complete /admin/v1 tree.
IDENTITY_ADMIN_TOKEN=
# Account-service bearer accepted only by access revoke, profile delete, and
# per-user devserver-policy routes. Leave empty to disable that caller scope.
IDENTITY_ACCOUNT_ADMIN_TOKEN=

# devserver-control admin client, used on PAT revoke / account delete /
# dashboard reads. DEVSERVER_ADMIN_URL is required when the token is
# set; the singular bearer must match the current value in
# devserver-control's DEVSERVER_IDENTITY_ADMIN_TOKENS ring.
DEVSERVER_ADMIN_URL=http://127.0.0.1:7003
DEVSERVER_IDENTITY_ADMIN_TOKEN=

# Configure at least ONE of the providers below (more is fine).
# identity-service refuses to start if none are set.

# GitHub: https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client IDs, Web application type)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitLab: https://gitlab.com/-/user_settings/applications
# (Scope: read_user)
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# RUST_LOG=info,identity=debug
