# /etc/chan-gateway/wireguard-agent.env
#
# Edit this file then `systemctl restart chan-gateway-wireguard-agent`.
# Permissions are 0640 root:chan-gateway-wireguard-agent; do not relax.
#
# The agent changes the peers of one kernel WireGuard interface, and only
# the peers it added itself. Bring the interface up before starting it; the
# agent never creates it or sets its key, port or addresses.

# identity-service's internal listener + the bearer presented on
# /internal/v1/wireguard/peers. The token must equal identity's
# WIREGUARD_AGENT_TOKEN. Generate with: openssl rand -hex 32
IDENTITY_URL=http://127.0.0.1:7004
WIREGUARD_AGENT_TOKEN=

# This node's ingress id and the kernel interface whose peers the agent
# keeps. The id is the node's DEVSERVER_PROXY_ID and must be one of the ids
# in identity's WIREGUARD_INGRESSES: identity answers 404 to any other id,
# and an agent that gets one applies no new peer list.
WIREGUARD_AGENT_HOST_ID=p1
WIREGUARD_INTERFACE=wg0

# Seconds between polls (1 to 60) and the wg executable.
# WIREGUARD_AGENT_POLL_SECS=5
# WIREGUARD_WG_BIN=/usr/bin/wg

# RUST_LOG=info
