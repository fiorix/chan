{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@chan/web-shared/command-deck": ["../web-shared/src/command-deck/model.ts"],
      "@chan/web-shared/CommandDeck.svelte": ["../web-shared/src/components/CommandDeck.svelte"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*", "src/**/*.svelte"]
}
