+// The guest driver writes this file only after it pins a persisted record
+// to one native X id. This diagnostic is applied only to the observer build.
+static RESTART_WATCHER_ID: AtomicU64 = AtomicU64::new(1);
+
+pub(crate) fn restart_event_ns() -> u128 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |duration| duration.as_nanos())
+}
+
+thread_local! {
+    static RESTART_CLOSE_PASS: Cell<Option<(u64, u64)>> = const { Cell::new(None) };
+}
+
+pub(crate) fn restart_close_pass() -> Option<(u64, u64)> {
+    RESTART_CLOSE_PASS.with(Cell::get)
+}
+
+struct RestartClosePassGuard(Option<(u64, u64)>);
+
+impl RestartClosePassGuard {
+    fn enter(watcher: u64, pass: u64) -> Self {
+        Self(RESTART_CLOSE_PASS.with(|current| current.replace(Some((watcher, pass)))))
+    }
+}
+
+impl Drop for RestartClosePassGuard {
+    fn drop(&mut self) {
+        RESTART_CLOSE_PASS.with(|current| current.set(self.0));
+    }
+}
+
+/// Whether this process runs under the restart observation's driver, which
+/// names its label file before it starts the desktop.
+pub(crate) fn restart_observing() -> bool {
+    std::env::var_os("CHAN_RESTART_LABEL_FILE").is_some()
+}
+
+pub(crate) fn restart_observed_label() -> Option<String> {
+    let path = std::env::var_os("CHAN_RESTART_LABEL_FILE")?;
+    let raw = std::fs::read_to_string(path).ok()?;
+    let label = raw.trim();
+    let (library, window) = label.split_once("::")?;
+    let library_hex = library.strip_prefix("lib-")?;
+    let window_hex = window.strip_prefix("w-")?;
+    if label.len() > 80
+        || library_hex.is_empty()
+        || window_hex.is_empty()
+        || !library_hex.bytes().all(|byte| byte.is_ascii_hexdigit())
+        || !window_hex.bytes().all(|byte| byte.is_ascii_hexdigit())
+    {
+        return None;
+    }
+    Some(label.to_owned())
+}
+
+#[derive(Clone, Copy)]
+struct RestartPass<'a> {
+    watcher: u64,
+    pass: u64,
+    label: &'a str,
+    branch: &'static str,
+}
