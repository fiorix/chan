{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher-control",
  "description": "Grants loopback-served launcher windows only the normal confirm-then-quit path.",
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "windows": ["main", "main-*"],
  "permissions": [
    "allow-request-app-quit"
  ]
}
