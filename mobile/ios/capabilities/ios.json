{
  "$schema": "../gen/schemas/iOS-schema.json",
  "identifier": "ios",
  "description": "The single iOS webview (label main) on the loopback launcher origin: back-to-Computers navigation, terminal background opacity commands, event subscriptions, and external URL opening.",
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "windows": ["main"],
  "permissions": [
    "allow-mobile-back-to-computers",
    "allow-terminal-background-opacity",
    "allow-set-terminal-background-opacity",
    "allow-toggle-launcher-panel",
    "allow-native-vocabulary",
    "allow-mobile-deliver-pending-show-card",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "opener:default",
    "opener:allow-open-url"
  ]
}
